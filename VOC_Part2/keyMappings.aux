\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces erank (solid/dashed) vs the erank$=k$ diagonal (black dashed). Shaded area = noise contamination predicted by Theorem~6.1(iii). Gap widens with $k$; steepening near $k=8$--$12$ marks $k_0$.}}{2}{figure.caption.5}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces erank vs $P$ at $k=4$ for three regularisation values. The non-monotone shape: erank peaks then declines beyond $P\approx 1000$--$4000$. The spectral gap does not show this behaviour, confirming the Section~3.5 parameter/structural complexity separation.}}{2}{figure.caption.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Spectral gap ratio heatmap. Monotone in both dimensions without exception. Coral line marks the $k=8\to 12$ boundary where 98\% structural collapse occurs at every $z$. The $k=12$ row is near-zero for all $z$.}}{3}{figure.caption.9}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Sharpe plots (Run~6, $P=4000$). Left: virtuous arc appears only at $z\geq 10$. Right: spectral gap predicts factor structure quality, not performance directly.}}{4}{figure.caption.11}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces $d_{\mathrm  {proj}}$ plots (Run~6 left, Run~2 right). Saturation is driven by ambient Grassmannian geometry, not loss curvature.}}{5}{figure.caption.14}\protected@file@percent }
